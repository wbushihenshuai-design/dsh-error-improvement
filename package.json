{
  "name": "dsh-error-improvement",
  "version": "0.1.0",
  "description": "Configurable user-confirmed lessons that help DeepSeek Harness avoid repeating mistakes.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "error-improvement",
    "lessons",
    "anti-regression"
  ],
  "license": "MIT",
  "author": "wbushihenshuai-design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbushihenshuai-design/dsh-error-improvement.git"
  },
  "homepage": "https://github.com/wbushihenshuai-design/dsh-error-improvement#readme",
  "bugs": {
    "url": "https://github.com/wbushihenshuai-design/dsh-error-improvement/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-client.mjs",
    "postinstall": "node scripts/prepare.mjs",
    "typecheck": "tsc -p tsconfig.test.json && node --check src/client.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "lint": "biome check src test scripts",
    "format": "biome check --write src test scripts",
    "preflight": "node scripts/preflight.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run preflight && npm run pack:smoke",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.2-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1 <0.2.0-0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
